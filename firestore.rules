rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && profile().status == 'approved'
        && (request.auth.token.email_verified == true || request.auth.token.email.matches('.*@phone[.]yeshiva[.]app'));
    }
    function manager() { return approved() && profile().role in ['rosh', 'admin', 'owner']; }
    function isOwner() { return approved() && profile().role == 'owner'; }
    function classKeyOfMine(key) { return key == 'class_' + string(profile().shiurId); }

    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || manager());
      allow list: if manager();
      // הרשמה עצמית: תמיד תלמיד במצב ממתין
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending';
      // תלמיד מעדכן רק את הפרטים האישיים שלו; מנהל משנה לא נוגע במנהל הראשי
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'studentStatus']))
        || (manager() && (isOwner() || (resource.data.role != 'owner' && request.resource.data.role != 'owner')));
      allow delete: if manager() && (isOwner() || resource.data.role != 'owner');
    }

    match /files/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid && request.resource.data.data.size() < 900000
        && (manager() || profile().role == 'rabbi');
      allow delete: if manager();
    }

    match /photos/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid && request.resource.data.data.size() < 400000;
      allow delete: if approved() && (resource.data.uid == request.auth.uid || manager());
    }

    match /kv/{key} {
      // תוכן כיתה: רק לאנשי אותו שיעור, או להנהלה
      // רשימת השיעורים והרבנים גלויה גם לפני הרשמה
      allow read: if key == 'classes' || approved() && (!key.matches('class_.*') || manager() || classKeyOfMine(key));
      allow write: if (key in ['schedule', 'scheduleFri', 'books', 'bookLinks', 'events', 'parasha', 'roshMsgs', 'roshPhoto', 'docs', 'pages', 'appLinks', 'classes', 'contacts'] && manager())
        || (key == 'posts' && approved())
        || (key.matches('class_.*') && approved()
            && (manager() || (profile().role == 'rabbi' && classKeyOfMine(key))));
    }
  }
}
